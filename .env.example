# ─────────────────────────────────────────────────────────────────────────
# wwxd configuration. Bring your own provider — Anthropic, OpenAI, Ollama,
# OpenRouter, vLLM, or anything else with an OpenAI-compatible HTTP API.
# ─────────────────────────────────────────────────────────────────────────


# ─────────────────────────────────────────────────────────────────────────
# API KEYS
# Get whatever you'll actually use. Skip the rest.
# ─────────────────────────────────────────────────────────────────────────

# Anthropic — required if LLM_PROVIDER=anthropic
# https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=

# OpenAI — required if LLM_PROVIDER=openai, or for embeddings on the default setup
# https://platform.openai.com/api-keys
OPENAI_API_KEY=

# Apify — required for the X-handle ingestion path (grounded personas)
# https://console.apify.com/account/integrations
APIFY_TOKEN=

# OpenAI-compatible (Ollama, OpenRouter, vLLM, LMStudio, anything OAI-shaped).
# Required if LLM_PROVIDER=openai-compatible. The base URL points at the host;
# the key is whatever that host expects (Ollama accepts any string).
LLM_API_KEY=
LLM_BASE_URL=

# Optional — separate credentials if your embedding provider differs from your
# chat provider. Falls back to LLM_BASE_URL / LLM_API_KEY when blank.
EMBEDDING_API_KEY=
EMBEDDING_BASE_URL=

# Quick reference for LLM_BASE_URL when running openai-compatible:
# Ollama:        http://localhost:11434/v1     LLM_API_KEY=ollama
# OpenRouter:    https://openrouter.ai/api/v1
# vLLM (local):  http://localhost:8000/v1      LLM_API_KEY=anything
# LMStudio:      http://localhost:1234/v1      LLM_API_KEY=lm-studio


# ─────────────────────────────────────────────────────────────────────────
# Chat / classifier / judge LLM
# ─────────────────────────────────────────────────────────────────────────

# Which provider answers chat / gate / classifier / judge roles.
# Values: anthropic | openai | openai-compatible
# Aliases mapped to openai-compatible: ollama | openrouter | vllm | lmstudio
LLM_PROVIDER=anthropic

# Model IDs per role. Leave blank to pick the per-provider default. Override
# if you want to mix-and-match within one provider (cheap gate, expensive chat).
CHAT_MODEL=
GATE_MODEL=
CLASSIFIER_MODEL=
JUDGE_MODEL=


# ─────────────────────────────────────────────────────────────────────────
# Embeddings (used for retrieval; without a provider, chat falls back to
# BM25-only). Defaults assume OpenAI's text-embedding-3-small at 512d.
# ─────────────────────────────────────────────────────────────────────────

# Values: openai | openai-compatible (alias: ollama)
EMBEDDING_PROVIDER=openai

EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSIONS=512
RETRIEVE_TOP_K=20


# ─────────────────────────────────────────────────────────────────────────
# Tweet ingestion (Apify) — only needed for grounded personas
# ─────────────────────────────────────────────────────────────────────────

# Values: apify | file
TWEET_PROVIDER=apify

# Override the actor if you want a different scraper from the Apify store.
APIFY_ACTOR=apidojo/tweet-scraper

# File provider — load tweets from a JSON file you bring yourself.
# Accepts a bare array of tweet objects OR a full wwxd corpus shape.
# If unset, the file ingester looks for `data/<username>.import.json`.
TWEET_FILE_PATH=


# ─────────────────────────────────────────────────────────────────────────
# Essay ingestion. http (default) scrapes URLs; file loads a JSON manifest.
# ─────────────────────────────────────────────────────────────────────────

# Values: http | file
ESSAY_PROVIDER=http

# File-provider path. Accepts [{ url?, title?, text }] or { essays: [...] }.
# If unset, the file ingester looks for `data/<username>.essays.import.json`.
ESSAY_FILE_PATH=


# ─────────────────────────────────────────────────────────────────────────
# YouTube ingestion. http (default) scrapes captions off the watch page;
# file loads a JSON manifest (useful when scraping breaks or you have
# paid transcripts).
# ─────────────────────────────────────────────────────────────────────────

# Values: http | file
YOUTUBE_PROVIDER=http

# File-provider path. Accepts [{ videoId, title?, text }] or { videos: [...] }.
# If unset, the file ingester looks for `data/<username>.youtube.import.json`.
YOUTUBE_FILE_PATH=
